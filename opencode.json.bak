{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context-mode": {
      "type": "local",
      "command": [
        "cmd",
        "/c",
        "context-mode"
      ]
    },
    "filesystem": {
      "type": "local",
      "command": [
        "node",
        "C:\\nvm4w\\nodejs\\node_modules\\@modelcontextprotocol\\server-filesystem\\dist\\index.js",
        "C:\\My Script\\auto",
        "C:\\My Script\\auto-ai"
      ]
    },
    "Sequential Thinking": {
      "type": "local",
      "command": [
        "node",
        "C:\\nvm4w\\nodejs\\node_modules\\@modelcontextprotocol\\server-sequential-thinking\\dist\\index.js"
      ]
    },
    "Tavily": {
      "type": "local",
      "command": [
        "cmd",
        "/c",
        "set TAVILY_API_KEY=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 && npx -y tavily-mcp@0.1.4"
      ]
    },
    "Memory": {
      "type": "local",
      "command": [
